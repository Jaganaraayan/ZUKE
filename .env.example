# ZUKE – AI Architectural Studio
# Root Environment Configuration Template

# Backend Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Google Gemini API Configuration (Google AI Studio)
# Get your API key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Cloudflare Workers AI - Free Tier Image Generation
# Get your credentials: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Frontend Configuration
VITE_API_URL=http://localhost:8000
